{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEPack v2 Evidence Record",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "type",
    "created_at",
    "claim",
    "result",
    "previous_hash",
    "record_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-"
    },
    "type": {
      "enum": [
        "command_execution",
        "manual_or_external"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "partial",
        "not-run"
      ]
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 80
      }
    }
  }
}
