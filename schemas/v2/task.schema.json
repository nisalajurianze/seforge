{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEPack v2 Task Packet",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "status",
    "workflow_skill",
    "risk",
    "acceptance_criteria",
    "skill_ids",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^TSK-"
    },
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "blocked",
        "review",
        "complete",
        "closed",
        "cancelled"
      ]
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "skill_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 80
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^EV-"
        },
        "uniqueItems": true
      }
    }
  }
}
